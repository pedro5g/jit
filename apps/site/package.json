{
  "name": "@jit/site",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/generate-jit-dts.mjs && node scripts/build-lab-compiler.mjs && pnpm run gen:api-surface && node scripts/build-docs-index.mjs && next dev",
    "build": "pnpm --filter @jit-compiler/jit build && node scripts/generate-jit-dts.mjs && node scripts/build-lab-compiler.mjs && pnpm run gen:api-surface && node scripts/build-docs-index.mjs && next build",
    "gen:dts": "node scripts/generate-jit-dts.mjs",
    "gen:lab": "node scripts/build-lab-compiler.mjs",
    "test": "pnpm run gen:api-surface && node scripts/build-docs-index.mjs && vitest run --config vitest.config.ts",
    "start": "next start",
    "postinstall": "fumadocs-mdx",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf .next .source",
    "gen:docs-index": "node scripts/build-docs-index.mjs",
    "gen:api-surface": "tsx --conditions @jit/source scripts/build-api-surface.ts",
    "eval:ghost": "tsx --conditions @jit/source scripts/eval-retrieval.ts",
    "audit:docs": "tsx --conditions @jit/source scripts/audit-docs.ts"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.2.0",
    "@jit-compiler/jit": "workspace:*",
    "@monaco-editor/react": "^4.7.0",
    "@vercel/blob": "^2.6.1",
    "clsx": "^2.1.1",
    "fumadocs-core": "^16.11.3",
    "fumadocs-mdx": "^15.1.0",
    "fumadocs-ui": "^16.11.3",
    "lucide-react": "^1.24.0",
    "motion": "^12.42.2",
    "next": "^16.2.10",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "shiki": "^4.3.1",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.2",
    "@types/mdx": "^2.0.13",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "monaco-editor": "^0.55.1",
    "tailwindcss": "^4.3.2",
    "typescript": "^6.0.3"
  }
}
