{
  "name": "@jit/site",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm run knowledge:build && node scripts/generate-jit-dts.mjs && node scripts/build-lab-compiler.mjs && next dev",
    "dev:knowledge": "pnpm run dev",
    "build": "pnpm --filter @jit-compiler/jit build && pnpm run knowledge:build && node scripts/generate-jit-dts.mjs && node scripts/build-lab-compiler.mjs && next build",
    "build:full": "pnpm run build",
    "gen:dts": "node scripts/generate-jit-dts.mjs",
    "gen:lab": "node scripts/build-lab-compiler.mjs",
    "test": "pnpm run gen:api-surface && node scripts/build-docs-index.mjs && vitest run --config vitest.config.ts",
    "start": "next start",
    "postinstall": "fumadocs-mdx",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf .next .source",
    "gen:docs-index": "node scripts/build-docs-index.mjs",
    "gen:api-surface": "tsx --conditions @jit/source scripts/build-api-surface.ts",
    "knowledge:build": "tsx --conditions @jit/source scripts/knowledge/cli.ts build",
    "knowledge:validate": "tsx --conditions @jit/source scripts/knowledge/cli.ts validate",
    "knowledge:inspect": "tsx --conditions @jit/source scripts/knowledge/cli.ts inspect",
    "knowledge:eval": "tsx --conditions @jit/source scripts/knowledge/cli.ts eval",
    "knowledge:eval:explain": "tsx --conditions @jit/source scripts/knowledge/cli.ts eval:explain",
    "knowledge:eval:capability": "tsx --conditions @jit/source scripts/knowledge/capability.ts",
    "knowledge:model:smoke": "tsx --conditions @jit/source scripts/knowledge/capability.ts --cases smoke",
    "knowledge:eval:models": "tsx --conditions @jit/source scripts/knowledge/capability.ts --cases smoke",
    "knowledge:inspect:capability": "tsx --conditions @jit/source scripts/knowledge/capability.ts --inspect",
    "knowledge:bench:vector": "tsx --conditions @jit/source scripts/knowledge/vector-benchmark.ts",
    "preknowledge:benchmark": "node scripts/build-docs-index.mjs",
    "knowledge:benchmark": "tsx --conditions @jit/source scripts/knowledge/benchmark.ts",
    "knowledge:rescore": "tsx --conditions @jit/source scripts/knowledge/rescore.ts",
    "knowledge:import": "tsx --conditions @jit/source scripts/knowledge/import-run.ts",
    "knowledge:label": "tsx --conditions @jit/source scripts/knowledge/label.ts",
    "knowledge:clean": "tsx --conditions @jit/source scripts/knowledge/cli.ts clean",
    "eval:ghost": "pnpm run knowledge:eval",
    "audit:docs": "tsx --conditions @jit/source scripts/audit-docs.ts"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.2.0",
    "@jit-compiler/jit": "workspace:*",
    "@monaco-editor/react": "^4.7.0",
    "@vercel/blob": "^2.6.1",
    "clsx": "^2.1.1",
    "fumadocs-core": "^16.11.3",
    "fumadocs-mdx": "^15.1.0",
    "fumadocs-ui": "^16.11.3",
    "lucide-react": "^1.24.0",
    "motion": "^12.42.2",
    "next": "^16.2.10",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "shiki": "^4.3.1",
    "tailwind-merge": "^3.6.0",
    "typescript": "^6.0.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.2",
    "@types/mdx": "^2.0.13",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "monaco-editor": "^0.55.1",
    "tailwindcss": "^4.3.2"
  }
}
